# =============================================================================
# Aether AI - environment variables for Render (or any cloud host)
# -----------------------------------------------------------------------------
# Set these in the Render dashboard:  Service -> Environment -> Add Environment
# Variable.  Never commit the filled-in values to Git.
# =============================================================================

# --- Host settings -----------------------------------------------------------
ENVIRONMENT=production
PYTHON_VERSION=3.11.9
# Render injects PORT automatically - do not set it manually.

# --- Security ----------------------------------------------------------------
# Render can generate this for you (render.yaml uses generateValue: true)
AETHER_SECRET_KEY=change-me-with-openssl-rand-hex-32
ALLOWED_ORIGINS=*

# --- AI providers (at least ONE is required for chat to work) ----------------
# Groq is free and extremely fast - https://console.groq.com/keys
GROQ_API_KEY=
# Or any of these:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=

# --- Model routing -----------------------------------------------------------
AI_PROVIDER=auto
ROUTER_CONVERSATION=groq
ROUTER_ANALYSIS=groq
ROUTER_CODE=groq
ROUTER_CREATIVE=groq
ROUTER_FAST=groq

# --- Optional tools ----------------------------------------------------------
TAVILY_API_KEY=          # web search tool - https://tavily.com
PORCUPINE_API_KEY=       # wake word detection (desktop only)

# --- Keep desktop-only features off in the cloud -----------------------------
ENABLE_SCREEN_MONITORING=false
ENABLE_PC_CONTROL=false
ENABLE_DAILY_REPORTS=false
ENABLE_BUGBOUNTY_AUTOPILOT=false
VOICE_INPUT_ENABLED=false
VOICE_OUTPUT_ENABLED=true

# --- Memory ------------------------------------------------------------------
CHROMADB_PATH=./data/chromadb
CONVERSATION_HISTORY_DB=./data/conversations.db
MAX_CONTEXT_MESSAGES=10
