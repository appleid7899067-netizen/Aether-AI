# URL of your Aether deployment (Render, VPS, ...). No trailing slash.
AETHER_API_URL=http://localhost:8000

# Optional: bearer token if you put auth in front of Aether
# AETHER_API_TOKEN=

# Optional: force the public base URL of THIS app (otherwise auto-detected
# from Vercel/Render env vars, falling back to http://localhost:$PORT)
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
